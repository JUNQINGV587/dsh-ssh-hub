{
  "name": "dsh-ssh-hub",
  "version": "0.4.0",
  "description": "Multi-server SSH terminal panel for DeepSeek Harness Web GUI — manage hosts and open multiple SSH terminals in a bottom panel",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/check-contrast.mjs && node scripts/check-group.mjs && node tests/integration.mjs",
    "prepublishOnly": "npm run build",
    "clean:blank": "node scripts/clean-blank-sessions.mjs",
    "clean:blank:dry": "node scripts/clean-blank-sessions.mjs --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ssh",
    "terminal",
    "multi-server",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
